# Flote -- environment variable skeleton (= structure only, NEVER commit real values)
#
# Copy this file to `.env` (= already in .gitignore) and fill in your own keys.
# Flote can run without ANY of these set; in that case it falls back to:
#   - Keychain (= for the user-entered Claude API key in Settings)
#   - Local Ollama (= for short / offline Organize)
#
# This file is the source of truth for which env vars are *recognised*.
# If you add a new var to the app, add it here too (with the value left empty).

# ---------- AI providers (= optional) ----------
# Anthropic Claude API key. User can also enter this from the in-app Settings UI;
# the Settings UI writes to Keychain, not to .env. Set this only for dev tooling.
ANTHROPIC_API_KEY=

# ---------- Distribution (= optional, used by scripts/) ----------
# Sparkle EdDSA private key, raw PEM contents (= used by scripts/sparkle-sign.sh).
# Read by the script as $SPARKLE_PRIVATE_KEY_FLOTE; never write the value here.
SPARKLE_PRIVATE_KEY_FLOTE=

# Cloudflare R2 credentials (= scripts/upload-r2.sh + scripts/generate-appcast.sh).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Apple Notarization (= scripts/notarize.sh). App-specific password flow.
MACOS_APPLE_ID=
MACOS_TEAM_ID=
MACOS_APP_SPECIFIC_PASSWORD=
